#include <stdio.h>

int main()
{
    // linhas = alunos; colunas = nota1, nota2, nota3, media
    float tabela[3][4];
    int aluno, nota;

    for (aluno = 0; aluno < 3; aluno++)
    {
        for (nota = 0; nota < 3; nota++)
        {
            printf("Digite a nota %d do aluno %d: ", nota + 1, aluno + 1);
            scanf("%f", &tabela[aluno][nota]);
        }
        tabela[aluno][3] = (tabela[aluno][0] + tabela[aluno][1] + tabela[aluno][2]) / 3;
    }

    printf("\n         nota1  nota2  nota3  media\n");
    for (aluno = 0; aluno < 3; aluno++)
    {
        printf("Aluno%d  %6.1f %6.1f %6.1f %6.1f\n", aluno + 1,
               tabela[aluno][0], tabela[aluno][1], tabela[aluno][2], tabela[aluno][3]);
    }

    return 0;
}
